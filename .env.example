# Hibou server configuration
# Copy to .env and adjust values as needed.

# Server
HIBOU_HOST=0.0.0.0
HIBOU_PORT=8080

# Database
HIBOU_DATABASE_URL=postgres://hibou:hibou@localhost:5432/hibou?sslmode=disable

# Logging: debug, info, warn, error
HIBOU_LOG_LEVEL=info
# Logging format: console, json
HIBOU_LOG_FORMAT=console

# Trivy server URL
HIBOU_TRIVY_URL=http://localhost:4954

# Session secret (change in production!)
HIBOU_SESSION_SECRET=change-me-in-production

# ─── Forge providers (indexed: HIBOU_FORGE_0_*, HIBOU_FORGE_1_*, ...) ───
# Supported types: github, forgejo, gitea, gitlab
# ID defaults to TYPE if omitted. Set a custom ID for multiple instances
# of the same forge type (e.g., "forgejo-staging", "forgejo-prod").

# Forgejo (local dev)
HIBOU_FORGE_0_TYPE=forgejo
HIBOU_FORGE_0_ID=forgejo
HIBOU_FORGE_0_URL=http://localhost:3000
HIBOU_FORGE_0_CLIENT_ID=
HIBOU_FORGE_0_CLIENT_SECRET=
HIBOU_FORGE_0_WEBHOOK_SECRET=

# GitHub (optional)
#HIBOU_FORGE_1_TYPE=github
#HIBOU_FORGE_1_ID=github
#HIBOU_FORGE_1_CLIENT_ID=
#HIBOU_FORGE_1_CLIENT_SECRET=
#HIBOU_FORGE_1_WEBHOOK_SECRET=

# GitLab (optional)
#HIBOU_FORGE_2_TYPE=gitlab
#HIBOU_FORGE_2_ID=gitlab
#HIBOU_FORGE_2_URL=https://gitlab.com
#HIBOU_FORGE_2_CLIENT_ID=
#HIBOU_FORGE_2_CLIENT_SECRET=
#HIBOU_FORGE_2_WEBHOOK_SECRET=
