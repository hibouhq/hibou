        }
       }
      }
     ],
     "properties": {
      "issue_confidence": "HIGH",
      "issue_severity": "LOW"
     },
     "ruleId": "B404",
     "ruleIndex": 0
    },
    {
     "message": {
      "text": "subprocess call with shell=True identified, security issue."
     },
