{
 "version": "2.1.0",
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Bandit",
     "version": "1.9.4",
     "semanticVersion": "1.9.4",
     "rules": [
      {
       "id": "B404",
       "name": "blacklist",
       "properties": {
        "tags": [
         "security",
         "external/cwe/cwe-78"
        ],
        "precision": "high"
       },
       "helpUri": "https://bandit.readthedocs.io/en/1.9.4/blacklists/blacklist_imports.html#b404-import-subprocess"
      },
      {
       "id": "B602",
       "name": "subprocess_popen_with_shell_equals_true",
       "properties": {
        "tags": [
         "security",
         "external/cwe/cwe-78"
        ],
        "precision": "high"
       },
       "helpUri": "https://bandit.readthedocs.io/en/1.9.4/plugins/b602_subprocess_popen_with_shell_equals_true.html"
      },
      {
       "id": "B607",
       "name": "start_process_with_partial_path",
       "properties": {
        "tags": [
         "security",
         "external/cwe/cwe-78"
        ],
        "precision": "high"
       },
       "helpUri": "https://bandit.readthedocs.io/en/1.9.4/plugins/b607_start_process_with_partial_path.html"
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "Consider possible security implications associated with the subprocess module."
     },
     "level": "note",
     "locations": [
