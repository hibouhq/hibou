       "name": "Missing User Instruction",
       "shortDescription": {
        "text": "Missing User Instruction"
       },
       "fullDescription": {
        "text": "Always set a user in the runtime stage of your Dockerfile. Without it, the container defaults to root, even if earlier build stages define a user."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "helpUri": "https://docs.docker.com/engine/reference/builder/#user",
       "relationships": [
