---
import Default from "@astrojs/starlight/components/SiteTitle.astro";
const currentVersion =
    import.meta.env.BASE_URL.split("/").filter(Boolean)[0] || "latest";
---

<div class="site-title-with-version">
    <Default {...Astro.props}><slot /></Default>
    <select
        id="version-select"
        class="version-select"
        aria-label="Documentation version"
    >
        <option value="stable" selected={currentVersion === "stable"}
            >stable</option
        >
        <option value="latest" selected={currentVersion === "latest"}
            >latest</option
        >
        {
            !["stable", "latest"].includes(currentVersion) && (
                <option value={currentVersion} selected>
                    {currentVersion}
                </option>
            )
        }
    </select>
</div>

<script>
    async function loadVersions() {
        const select = document.getElementById(
            "version-select",
        ) as HTMLSelectElement;
        if (!select) return;

        try {
            const origin = window.location.origin;
            const res = await fetch(`${origin}/versions.json`);
            if (!res.ok) return;

            const versions: string[] = await res.json();
            const currentPath = window.location.pathname;
            const match = currentPath.match(/^\/([^/]+)\//);
            const currentVersion = match ? match[1] : "latest";

            select.innerHTML = "";
            for (const v of versions) {
                const opt = document.createElement("option");
                opt.value = v;
                opt.textContent = v;
                if (v === currentVersion) opt.selected = true;
                select.appendChild(opt);
            }

            select.addEventListener("change", () => {
                const newVersion = select.value;
                const rest = currentPath.replace(/^\/[^/]+/, "");
                window.location.href = `${origin}/${newVersion}${rest}`;
            });
        } catch {
            // Local dev — no versions.json, keep default
        }
    }

    loadVersions();
</script>

<style>
    .site-title-with-version {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-width: 0;
    }

    .version-select {
        background: var(--sl-color-bg-nav);
        color: var(--sl-color-white);
        border: 2px solid var(--hb-line);
        border-radius: 0;
        padding: 0.35rem;
        max-width: 7.5rem;
        font: 0.75rem var(--sl-font-mono);
        cursor: pointer;
    }

    .version-select:hover {
        border-color: var(--sl-color-accent);
    }
</style>
