{
  "name": "hibou",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080, 3000, 3030, 4321, 4322, 4954, 5432],
  "portsAttributes": {
    "3000": { "label": "Vite Dev Server (Frontend)", "onAutoForward": "notify" },
    "3030": { "label": "Forgejo", "onAutoForward": "silent" },
    "4321": { "label": "Astro Docs", "onAutoForward": "silent" },
    "4322": { "label": "Astro Docs (HMR)", "onAutoForward": "silent" },
    "4954": { "label": "Trivy Server", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "8080": { "label": "Hibou API Server", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "Vue.volar",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "ms-ossdata.vscode-pgsql",
        "astro-build.astro-vscode",
        "editorconfig.editorconfig",
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "go.formatTool": "gofmt",
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "postCreateCommand": "go mod download && go install github.com/go-delve/delve/cmd/dlv@latest && go install github.com/sqlc-dev/sqlc/cmd/sqlc@latest && cd site && npm install",
  "remoteUser": "vscode"
}