# fetch-verified URL DEST: download URL and fail unless it matches its pinned sha256.
COPY --chmod=0755 <<'EOF' /usr/local/share/devcontainer/fetch-verified
#!/usr/bin/env bash
set -euo pipefail
url="$1" dest="$2"
want="$(awk -v u="${url}" '$2 == u { print $1; exit }' /usr/local/share/devcontainer/SHA256SUMS)"
if [ -z "${want}" ]; then
    echo "fetch-verified: no pinned sha256 for ${url}; run .devcontainer/scripts/update-checksums.sh" >&2
    exit 1
fi
curl -fsSL --retry 3 -o "${dest}" "${url}"
echo "${want}  ${dest}" | sha256sum -c --quiet - || { rm -f "${dest}"; exit 1; }
EOF

RUN <<EOF
    packages=(
        postgresql-client
        ca-certificates
        curl
        gnupg
        dnsutils
    )
    apt-get update
    apt-get install -y --no-install-recommends "${packages[@]}"
    apt-get clean -y
    rm -rf /var/lib/apt/lists/*
EOF

RUN <<EOF
    fetch=/usr/local/share/devcontainer/fetch-verified
    "${fetch}" "https://dl.google.com/go/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" /tmp/go.tar.gz
    tar -xzf /tmp/go.tar.gz -C /usr/local
    rm -f /tmp/go.tar.gz
    echo 'export PATH="/usr/local/go/bin:${PATH}:${HOME}/go/bin"' > /etc/profile.d/go.sh
EOF

ENV PATH="/usr/local/go/bin:${PATH}:/home/vscode/go/bin"

RUN <<EOF
    fetch=/usr/local/share/devcontainer/fetch-verified
    node_arch="$(echo "${TARGETARCH}" | sed 's/amd64/x64/')"
    "${fetch}" "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.gz" /tmp/node.tar.gz
    tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 --no-same-owner \
        --wildcards '*/bin' '*/include' '*/lib' '*/share'
    rm -f /tmp/node.tar.gz
    node --version

    npm install -g "@playwright/cli@${PLAYWRIGHT_CLI_VERSION}"
    playwright-cli --version
EOF

RUN <<EOF
    fetch=/usr/local/share/devcontainer/fetch-verified
    arch="$(echo "${TARGETARCH}" | sed 's/arm64/aarch64/' | sed 's/amd64/x86_64/')"
    # swag release assets use x86_64/arm64 naming (not aarch64)
    swag_arch="$(echo "${TARGETARCH}" | sed 's/amd64/x86_64/')"
    trivy_arch='64bit'
    if [ "${TARGETARCH}" = 'arm64' ]; then
        trivy_arch='ARM64'
    fi
    cd /tmp

    # Install Go tools from prebuilt release binaries rather than `go install`.
    # `go install` compiles from source under Go ${GO_VERSION}, and these pinned
    # versions reference golang.org/x/tools v0.8.0-v0.25.0, which fail to build
    # on Go 1.25+ (golang/go#74462: "invalid array length -delta * delta").
    "${fetch}" "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz --strip-components=1 -C /usr/local/bin --wildcards '*/golangci-lint'
    golangci-lint --version

    "${fetch}" "https://github.com/securego/gosec/releases/download/v${GOSEC_VERSION}/gosec_${GOSEC_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin gosec
    gosec --version

    # Pinned version: the module download is verified against go.sum / sum.golang.org.
    GOBIN=/usr/local/bin go install "github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION}"
    dlv version

    "${fetch}" "https://github.com/sqlc-dev/sqlc/releases/download/v${SQLC_VERSION}/sqlc_${SQLC_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin sqlc
    sqlc version

    "${fetch}" "https://github.com/swaggo/swag/releases/download/v${SWAG_VERSION}/swag_${SWAG_VERSION}_Linux_${swag_arch}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin swag
    chmod 755 /usr/local/bin/swag
    swag --version

    "${fetch}" "https://github.com/gotestyourself/gotestsum/releases/download/v${GOTESTSUM_VERSION}/gotestsum_${GOTESTSUM_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin gotestsum
    gotestsum --version

    "${fetch}" "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${trivy_arch}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin trivy
    trivy --version

    gitleaks_arch="$(echo "${TARGETARCH}" | sed 's/amd64/x64/')"
    "${fetch}" "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gitleaks_arch}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin gitleaks
    gitleaks version

    # Dev only: the trufflehog provider is disabled in the server and the binary
    # is NOT in the runtime image (it needs /bin/sh for its file:// re-clone, and
    # we keep the scanner image shell-free). Installed here so the kept code
    # stays exercisable.
    "${fetch}" "https://github.com/trufflesecurity/trufflehog/releases/download/v${TRUFFLEHOG_VERSION}/trufflehog_${TRUFFLEHOG_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin trufflehog
    trufflehog --version

    betterleaks_arch="$(echo "${TARGETARCH}" | sed 's/amd64/x64/')"
    "${fetch}" "https://github.com/betterleaks/betterleaks/releases/download/v${BETTERLEAKS_VERSION}/betterleaks_${BETTERLEAKS_VERSION}_linux_${betterleaks_arch}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin betterleaks
    betterleaks version

    rtk_target='unknown-linux-gnu'
    if [ "${TARGETARCH}" = 'amd64' ]; then
        rtk_target='unknown-linux-musl'
    fi
    "${fetch}" "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-${arch}-${rtk_target}.tar.gz" t.tgz
    tar -xzf t.tgz -C /usr/local/bin rtk
    rtk --version

    "${fetch}" "https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}/gh_${GH_CLI_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz --strip-components=2 -C /usr/local/bin --wildcards '*/bin/gh'
    gh --version

    rm -f t.tgz
EOF

FROM base AS build-tools-infra
ARG TARGETARCH
ARG APKO_VERSION KUBECTL_VERSION K9S_VERSION OPENTOFU_VERSION HELM_VERSION ORAS_VERSION VCLUSTER_VERSION

RUN <<EOF
    fetch=/usr/local/share/devcontainer/fetch-verified
    out=/tmp/output-bin
    mkdir -p "${out}"
    cd /tmp

    "${fetch}" "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" "${out}/kubectl"
    chmod +x "${out}/kubectl"
    "${out}/kubectl" version --client

    "${fetch}" "https://github.com/derailed/k9s/releases/download/v${K9S_VERSION}/k9s_Linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C "${out}" k9s
    "${out}/k9s" version

    "${fetch}" "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C "${out}" tofu
    "${out}/tofu" version

    "${fetch}" "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C "${out}" "linux-${TARGETARCH}/helm" --strip-components=1
    "${out}/helm" version

    "${fetch}" "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C "${out}" oras
    "${out}/oras" version

    "${fetch}" "https://github.com/loft-sh/vcluster/releases/download/v${VCLUSTER_VERSION}/vcluster-linux-${TARGETARCH}" "${out}/vcluster"
    chmod +x "${out}/vcluster"
    "${out}/vcluster" version

    "${fetch}" "https://github.com/chainguard-dev/apko/releases/download/v${APKO_VERSION}/apko_${APKO_VERSION}_linux_${TARGETARCH}.tar.gz" t.tgz
    tar -xzf t.tgz -C "${out}" --strip-components=1 --wildcards '*/apko'
    "${out}/apko" version

    rm -f t.tgz
EOF

FROM base AS final
ARG DIND_FEATURE_VERSION

RUN <<EOF
    # No upstream checksum is published for this script: it is pinned to the
    # sha256 of the file at the feature's release tag.
    /usr/local/share/devcontainer/fetch-verified \
        "https://raw.githubusercontent.com/devcontainers/features/feature_docker-in-docker_${DIND_FEATURE_VERSION}/src/docker-in-docker/install.sh" \
        /tmp/docker-in-docker-install.sh
    chmod +x /tmp/docker-in-docker-install.sh

    VERSION="latest" \
    MOBY="true" \
    DOCKERDASHCOMPOSEVERSION="v2" \
    USERNAME="vscode" \
    INSTALLDOCKERBUILDX="true" \
    /tmp/docker-in-docker-install.sh

    rm -f /tmp/docker-in-docker-install.sh
EOF

COPY --from=build-tools-infra /tmp/output-bin/ /usr/local/bin/
