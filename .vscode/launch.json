{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "hibou serve",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "args": ["serve"],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "HIBOU_LOG_LEVEL": "debug",
        "HIBOU_LOG_FORMAT": "console"
      }
    },
    {
      "name": "hibou version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "args": ["version"]
    },
    {
      "name": "hibou (custom args)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "args": ["${input:cobraCommand}"]
    }
  ],
  "inputs": [
    {
      "id": "cobraCommand",
      "type": "promptString",
      "description": "Cobra subcommand and flags (e.g. 'upload sbom --file bom.json')"
    }
  ]
}
